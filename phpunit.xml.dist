<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php" cacheResult="false" colors="true"
         failOnDeprecation="true" failOnPhpunitDeprecation="true" failOnPhpunitNotice="true"
         failOnPhpunitWarning="true" failOnEmptyTestSuite="true" failOnIncomplete="true"
         failOnNotice="true" failOnRisky="true" failOnWarning="true">
    <testsuites>
        <testsuite name="http-responder"><directory>tests</directory></testsuite>
    </testsuites>
    <source><include><directory>src</directory></include></source>
</phpunit>
